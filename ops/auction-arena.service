[Unit]
Description=IPL Auction Arena
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/auction-arena/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4173
Environment=ALLOWED_ORIGINS=https://auction-vm.nik.am.in
Environment=SEASONS_DB_PATH=/home/ubuntu/projects/auction-arena/data/seasons.sqlite
Environment=ROOM_CHECKPOINTS=1
Environment=ROOM_DATA_DIR=/home/ubuntu/projects/auction-arena/data/rooms
ExecStart=/home/ubuntu/projects/auction-arena/runtime/bin/node /home/ubuntu/projects/auction-arena/current/server/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
